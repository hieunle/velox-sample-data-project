              "rules": [
                {
                  "key": "BR-002",
                  "plain": "The warehouse stores units produced as good units plus rejected units, not as the MES good count",
                  "status": "CODE-ONLY"
                },
                {
                  "key": "BR-003",
                  "plain": "After loading a day, the load stops with an error if any run has more rejected than produced units; the loaded rows are not rolled back",
                  "status": "VERIFIED"
                },
                {
                  "key": "BR-005",
                  "plain": "A MES run whose machine or product SKU is not yet in the warehouse is silently left out of the day's load",
                  "status": "CODE-ONLY"
                },
                {
                  "key": "BR-006",
                  "plain": "Re-running the production load for a day deletes that day and loads it again",
                  "status": "CODE-ONLY"
                }
              ],
              "source": null
